# Kawing - environment template. Copy to .env and fill in.
# NEVER commit a real .env. No secrets belong in Git.

# --- Database -----------------------------------------------------------
# PostgreSQL, both for local dev and production (Neon, via Vercel Postgres).
# Two connection strings, because Prisma needs different ones for different
# jobs:
#   DATABASE_URL           pooled (pgbouncer) - the running app's client
#                          (src/lib/db.ts). Handles many concurrent
#                          serverless invocations correctly.
#   DATABASE_URL_UNPOOLED  direct (no pgbouncer) - `prisma migrate`
#                          (prisma.config.ts). Pooled connections in
#                          transaction mode don't reliably support the
#                          advisory locks migrations take.
# On Vercel these two (plus their POSTGRES_* aliases) are injected
# automatically once a Postgres database is attached under the project's
# Storage tab - nothing to set there. For LOCAL development, get both
# values from the Neon Console (Vercel dashboard -> Storage -> your database
# -> "Open in Neon Console" -> Connection Details): the "Pooled connection"
# string goes in DATABASE_URL, the "Direct connection" string in
# DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Session ------------------------------------------------------------
# Signing key for the httpOnly session cookie. Generate a unique value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-32-byte-random-hex-string"

# --- AI provider (OPTIONAL) --------------------------------------------
# Kawing's agents are rule-driven and run fully WITHOUT any API key.
# A key only enables natural-language phrasing of already-computed findings.
# Leave blank to run in deterministic RULES mode.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
AI_MODEL=""
